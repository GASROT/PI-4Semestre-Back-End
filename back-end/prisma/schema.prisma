generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GARCOM
  CLIENTE
}

enum StatusMesa {
  DISPONIVEL
  OCUPADA
  RESERVADA
  MANUTENCAO
}

enum ComandaStatus {
  ABERTA
  FINALIZADA
  CANCELADA
}

enum TipoEvento {
  CHAMAR_GARCOM
  LIMPEZA_INICIADA
  LIMPEZA_CONCLUIDA
  MESA_ABERTA
  MESA_FECHADA
}

enum StatusPreparo {
  PENDENTE
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum StatusPagamento {
  ABERTO
  PARCIAL
  PAGO
  ESTORNADO
}

model Usuario {
  id            String      @id @default(uuid()) @db.Uuid
  nome          String
  email         String      @unique
  senha         String
  cpf           String?     @unique
  celular       String?
  ativo         Boolean     @default(true)
  turno         String?
  roles         UsuarioRole[]
  mesas         UsuarioMesa[]
  comandas      Comanda[]
  reservas      Reserva[]
  criado_em     DateTime    @default(now())
  atualizado_em DateTime    @updatedAt
}

model UsuarioRole {
  id         String  @id @default(uuid()) @db.Uuid
  usuario_id String  @db.Uuid
  role       Role
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@unique([usuario_id, role])
}

model Mesa {
  id            String       @id @default(uuid()) @db.Uuid
  numero        Int          @unique
  capacidade    Int
  status        StatusMesa   @default(DISPONIVEL)
  codigo_mesa   Int          @unique
  ativa         Boolean      @default(true)
  token_acesso  String?      @unique
  sessao_id     String?      @unique
  device_id     String?
  aberta_em     DateTime?
  fechada_em    DateTime?
  total         Float        @default(0)
  usuarios      UsuarioMesa[]
  comandas      Comanda[]
  eventos       EventoMesa[]
  reservas      Reserva[]
  pedidos       Pedido[]      // Manter para compatibilidade, mas prefira via Comanda
  criado_em     DateTime     @default(now())
  atualizado_em DateTime     @updatedAt
}

model UsuarioMesa {
  id         String  @id @default(uuid()) @db.Uuid
  usuario_id String  @db.Uuid
  mesa_id    String  @db.Uuid
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  mesa       Mesa    @relation(fields: [mesa_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([mesa_id])
  @@unique([usuario_id, mesa_id])
}

model Pedido {
  id               String          @id @default(uuid()) @db.Uuid
  mesa_id          String          @db.Uuid
  comanda_id       String?         @db.Uuid
  num_pedido       Int             @unique
  data_hora        DateTime        @default(now())
  status_preparo   StatusPreparo   @default(PENDENTE)
  status_pagamento StatusPagamento @default(ABERTO)
  valor_total      Float           @default(0)
  mesa             Mesa            @relation(fields: [mesa_id], references: [id])
  comanda          Comanda?        @relation(fields: [comanda_id], references: [id], onDelete: SetNull)
  itens            ItemPedido[]
  criado_em        DateTime        @default(now())
  atualizado_em    DateTime        @updatedAt

  @@index([mesa_id])
  @@index([comanda_id])
}

model ItemPedido {
  id             String  @id @default(uuid()) @db.Uuid
  pedido_id      String  @db.Uuid
  produto_id     String  @db.Uuid
  num_item       Int
  quantidade     Float
  preco_snapshot Float
  subtotal       Float
  pedido         Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  produto        Produto @relation(fields: [produto_id], references: [id])

  @@unique([pedido_id, num_item])
  @@index([pedido_id])
  @@index([produto_id])
}

model Produto {
  id             String              @id @default(uuid()) @db.Uuid
  nome           String
  preco_unitario Float
  qtd_estoque    Float
  ativo          Boolean             @default(true)
  desativado_em  DateTime?
  categorias     ProdutoCategoria[]
  fornecedores   ProdutoFornecedor[]
  itens_pedido   ItemPedido[]
  criado_em      DateTime            @default(now())
}

model Categoria {
  id        String             @id @default(uuid()) @db.Uuid
  descricao String             @unique
  produtos  ProdutoCategoria[]
}

model ProdutoCategoria {
  produto_id   String    @db.Uuid
  categoria_id String    @db.Uuid
  produto      Produto   @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  categoria    Categoria @relation(fields: [categoria_id], references: [id], onDelete: Cascade)

  @@id([produto_id, categoria_id])
}

model Fornecedor {
  id           String              @id @default(uuid()) @db.Uuid
  razao_social String
  cnpj         String              @unique
  ativo        Boolean             @default(true)
  produtos     ProdutoFornecedor[]
}

model Comanda {
  id            String        @id @default(uuid()) @db.Uuid
  mesa_id       String        @db.Uuid
  usuario_id    String?       @db.Uuid
  status        ComandaStatus @default(ABERTA)
  total         Float         @default(0)
  criado_em     DateTime      @default(now())
  finalizado_em DateTime?
  
  mesa          Mesa          @relation(fields: [mesa_id], references: [id], onDelete: Cascade)
  usuario       Usuario?      @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  pedidos       Pedido[]
  
  @@index([mesa_id])
  @@index([usuario_id])
}

model EventoMesa {
  id            String     @id @default(uuid()) @db.Uuid
  mesa_id       String     @db.Uuid
  tipo          TipoEvento
  descricao     String?
  device_id     String?
  criado_em     DateTime   @default(now())
  
  mesa          Mesa       @relation(fields: [mesa_id], references: [id], onDelete: Cascade)
  
  @@index([mesa_id])
  @@index([criado_em])
}

model Reserva {
  id            String   @id @default(uuid()) @db.Uuid
  mesa_id       String   @db.Uuid
  usuario_id    String   @db.Uuid
  data_reserva  DateTime
  duracao_min   Int      @default(120)
  status        String   @default("CONFIRMADA")
  criado_em     DateTime @default(now())
  
  mesa          Mesa     @relation(fields: [mesa_id], references: [id], onDelete: Cascade)
  usuario       Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  
  @@index([mesa_id])
  @@index([usuario_id])
  @@index([data_reserva])
}

model ProdutoFornecedor {
  produto_id    String     @db.Uuid
  fornecedor_id String     @db.Uuid
  produto       Produto    @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  fornecedor    Fornecedor @relation(fields: [fornecedor_id], references: [id], onDelete: Cascade)

  @@id([produto_id, fornecedor_id])
}
